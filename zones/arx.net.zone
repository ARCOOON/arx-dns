$TTL 86400          ; Cache timeout (1d)

@       IN  SOA     dns.arx.net. admin.arx.local. (
                    2026100601 ; Serial (JJJJMMDD + Version)
                    28800      ; Refresh (8h)
                    7200       ; Retry (2h)
                    86400      ; Expire (1d)
                    3600       ; Minimum TTL
                    )

@       IN  NS      dns.arx.net.
@       IN  A       192.168.1.1
